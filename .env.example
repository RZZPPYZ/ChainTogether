# ChainTogether extracted runtime configuration.
# The extracted server currently keeps Octopus's existing env prefix to avoid risky broad renames.
OCTOPUS_AUTH_TOKEN=changeme
OCTOPUS_HOST=0.0.0.0
OCTOPUS_PORT=8000
OCTOPUS_DEFAULT_WORKING_DIR=.
OCTOPUS_DB_PATH=chaintogether.db
OCTOPUS_ATTACHMENTS_DIR=~/.chaintogether/attachments
OCTOPUS_LARGE_PROMPTS_DIR=~/.chaintogether/large-prompts
OCTOPUS_CODEX_HOME_DIR=~/.chaintogether/codex
OCTOPUS_AGENTS_DIR=~/.chaintogether/agents
OCTOPUS_PERSONAS_DIR=~/.chaintogether/personas
OCTOPUS_CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]
OCTOPUS_DEBUG=false
OCTOPUS_ENABLE_TUNNEL=false

# Turn watchdogs. Set a value to 0 to disable that check. Group turns default
# to no automatic timeout and can always be stopped from the group composer.
OCTOPUS_TURN_IDLE_TIMEOUT_SECONDS=300
OCTOPUS_TURN_MAX_SECONDS=1800
OCTOPUS_GROUP_TURN_IDLE_TIMEOUT_SECONDS=0
OCTOPUS_GROUP_TURN_MAX_SECONDS=0

# Optional bridge/connectors.
# OCTOPUS_TELEGRAM_BOT_TOKEN=
# OCTOPUS_PUBLIC_BASE_URL=http://127.0.0.1:8000
# OCTOPUS_GMAIL_OAUTH_CLIENT_ID=
# OCTOPUS_GMAIL_OAUTH_CLIENT_SECRET=
# OCTOPUS_GITHUB_OAUTH_CLIENT_ID=
# OCTOPUS_GITHUB_OAUTH_CLIENT_SECRET=
